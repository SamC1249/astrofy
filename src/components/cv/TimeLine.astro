---
const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="lx-tl-dot block rounded-full mt-1"></span>
    <span class="education__line lx-tl-line block h-full translate-x-[5px]"></span>
  </div>
  <div class="experience__data px-5 pb-2">
    <h3 class="lx-tl-title">{title}</h3>
    <span class="lx-tl-subtitle">{subtitle}</span>
    <p class="lx-tl-body">
      <slot />
    </p>
  </div>
</div>

<style>
  .lx-tl-dot {
    width: 11px;
    height: 11px;
    background: var(--accent-tint);
    border: 2px solid var(--accent);
  }
  .lx-tl-line {
    width: 1px;
    background: var(--hairline);
  }
  .lx-tl-title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.012em;
    color: var(--text-1);
  }
  .lx-tl-subtitle {
    font-size: 0.8125rem;
    color: var(--text-4);
  }
  .lx-tl-body {
    margin: 8px 0 16px;
    font-size: 0.875rem;
    color: var(--text-3);
    text-wrap: pretty;
  }
</style>
