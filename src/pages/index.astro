---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import AsciiKnot from "../components/AsciiKnot.astro";
import ParticleName from "../components/ParticleName.astro";
import AboutPanel from "../components/AboutPanel.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="lx-hero-top">
    <ParticleName />
  </section>

  <section class="lx-hero-grid">
    <div class="lx-hero-left">
      <span class="lx-pill"><span class="lx-dot"></span>Biography</span>
      <p class="lx-bio">
        I'm currently a sophomore at Harvard from Boston, Massachusetts. I study Computer Science, Mathematics, and Psychology. Currently, I work on mechanistic interpretability in the Computation,
        Cognition, and Development Lab and Hierarchical Reinforcement Learning under Kempner and the Brantley Lab.
      </p>
      <p class="lx-bio">
        I was a competitive debater, ranking at my peak 6th nationally in Public Forum. I went on to found Outreach Debate, a debate non-profit with 1,800+ members and 300+ volunteers,
        as well as 2 businesses in the education space doing 5 and 6 figures in revenue.
      </p>
      <div class="lx-hero-actions">
        <a class="lx-btn lx-btn-primary" href="mailto:sam_chen@college.harvard.edu" target="_blank">Email Me</a>
        <a class="lx-btn lx-btn-secondary" href="https://linkedin.com/in/sam-chen-massachusetts" target="_blank">LinkedIn</a>
        <a class="lx-btn lx-btn-secondary" href="https://github.com/SamC1249" target="_blank">View my GitHub</a>
      </div>
    </div>
    <div class="lx-hero-right">
      <AboutPanel />
    </div>
  </section>


  <section class="lx-section lx-reveal">
    <p class="lx-kicker mb-2">01 — Writing</p>
    <h2 class="lx-title-lg mb-4">Latest from blog</h2>

    {
      last_posts.map((post, i) => (
        <>
          {i > 0 && <div class="lx-row-divider" />}
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
          />
        </>
      ))
    }
  </section>

  <AsciiKnot>
    <p class="lx-kicker mb-2">03 — Contact</p>
    <h2 class="lx-title-lg">Get in touch</h2>
    <p class="lx-bio">
      Always happy to talk research, startups, or debate.
    </p>
    <div class="lx-hero-actions">
      <a class="lx-btn lx-btn-primary" href="mailto:sam_chen@college.harvard.edu" target="_blank">Email Me</a>
      <a class="lx-btn lx-btn-secondary" href="https://linkedin.com/in/sam-chen-massachusetts" target="_blank">LinkedIn</a>
    </div>
  </AsciiKnot>
</BaseLayout>

<style>
  .lx-hero-top {
    padding-top: 56px;
    text-align: center;
  }
  .lx-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: 48px;
  }
  @media (max-width: 880px) {
    .lx-hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .lx-bio {
    margin-top: 16px;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .lx-hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .lx-section {
    padding: 64px 0 0;
  }
  .mb-2 { margin-bottom: 8px; }
  .mb-4 { margin-bottom: 16px; }
</style>
